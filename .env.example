# Fireworks AI (Gemma 4) - Required for report generation
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
GEMMA_MODEL=accounts/fireworks/models/gemma-4-31b-it

# MedGemma (local vLLM) - Optional, regex fallback available
MEDGEMMA_BASE_URL=http://localhost:8001/v1
MEDGEMMA_MODEL=google/medgemma-4b-it

# TxGemma (local vLLM) - Optional, database fallback available
TXGEMMA_BASE_URL=http://localhost:8002/v1
TXGEMMA_MODEL=google/txgemma-2b-it

# Feature flags — default UI toggle states.
# CPU-only setups keep the local vLLM models off (regex parser + rules DB
# still cover parsing and DDI checks); set the first two to true on a GPU pod.
USE_LLM_PARSER=false
USE_TXGEMMA=false
USE_GEMMA4=true
