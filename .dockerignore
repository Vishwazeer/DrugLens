# Secrets — never bake into images
.env

# VCS / environments / caches
.git
.gitignore
.venv
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Frontend build artifacts — the image builds these itself (npm ci + npm run build)
frontend/node_modules/
frontend/dist/

# Dev-only artifacts
tests/
scripts/
.github/
PROGRESS.md
requirements-dev.txt
.playwright-mcp/
